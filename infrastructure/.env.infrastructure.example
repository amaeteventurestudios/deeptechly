POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=deeptechly
POSTGRES_USER=deeptechly
POSTGRES_PASSWORD=replace-with-a-long-local-secret
POSTGRES_PORT=5433

VALKEY_IMAGE=valkey/valkey:8-alpine
VALKEY_PASSWORD=replace-with-a-long-local-secret
VALKEY_PORT=6380

MEILISEARCH_IMAGE=getmeili/meilisearch:v1.15
MEILISEARCH_MASTER_KEY=replace-with-a-long-local-secret-at-least-16-bytes
MEILISEARCH_PORT=7700

DIRECTUS_IMAGE=directus/directus:11.5.1
DIRECTUS_SECRET=replace-with-a-long-local-secret
DIRECTUS_ADMIN_EMAIL=admin@example.test
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-local-secret
DIRECTUS_PORT=8055

# Application-side newsroom adapter (copy to the app environment only when activated)
DEEPTECHLY_NEWSROOM_PROVIDER=compatibility
DIRECTUS_BASE_URL=http://127.0.0.1:8055
DIRECTUS_STUDIO_URL=http://127.0.0.1:8055/admin
DIRECTUS_TOKEN=replace-with-a-scoped-static-token
