OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ENABLE_WEB_SEARCH=true
NEXT_PUBLIC_SITE_URL=https://deeptechly.vercel.app

# Appwrite identity (server-only). Required API-key scopes: users.read,
# users.write, and sessions.write. Never expose APPWRITE_API_KEY to the browser.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Optional override; defaults to a_session_<project-id>.
APPWRITE_SESSION_COOKIE_NAME=
# Reserved for Appwrite account capability metadata if adopted later. DeepTechly
# application data remains in PostgreSQL and does not require this value.
APPWRITE_DATABASE_ID=

# Research workflow. `local` preserves current behavior; `trigger` requires every value below.
DEEPTECHLY_WORKFLOW_PROVIDER=local
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Optional for a self-hosted Trigger.dev API; managed Trigger.dev uses its SDK default.
TRIGGER_API_URL=
DEEPTECHLY_INTERNAL_WEB_URL=
# Generate independently for each environment; minimum 24 characters.
DEEPTECHLY_WORKER_CALLBACK_SECRET=

# Authoritative V2 PostgreSQL application database (server-only).
DEEPTECHLY_V2_DATABASE_URL=
# Component form may be used instead of the URL.
DEEPTECHLY_V2_DATABASE_HOST=
DEEPTECHLY_V2_DATABASE_PORT=5432
DEEPTECHLY_V2_DATABASE_NAME=
DEEPTECHLY_V2_DATABASE_USER=
DEEPTECHLY_V2_DATABASE_PASSWORD=
DEEPTECHLY_V2_DATABASE_SSL=require
DEEPTECHLY_V2_DATABASE_POOL_SIZE=8

# Admin bootstrap and authorization.
ADMIN_EMAILS=
DEEPTECHLY_BOOTSTRAP_ADMIN_EMAIL=
DEEPTECHLY_BOOTSTRAP_ADMIN_TEMP_PASSWORD=

# Optional V2 capability adapters. Unset means disabled; configuration never starts a service.
CRAWL4AI_BASE_URL=
CRAWL4AI_TOKEN=
CRAWL4AI_HEALTH_PATH=/health
CRAWL4AI_ACQUIRE_PATH=/crawl
CRAWL4AI_TIMEOUT_MS=30000

DIRECTUS_BASE_URL=
DIRECTUS_TOKEN=
DIRECTUS_TIMEOUT_MS=15000
# Keep `compatibility` until the V2 PostgreSQL import and Directus collection setup are reconciled.
DEEPTECHLY_NEWSROOM_PROVIDER=compatibility
# Browser-facing Data Studio URL; never include a token.
DIRECTUS_STUDIO_URL=

MEILISEARCH_BASE_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_TIMEOUT_MS=15000
MEILISEARCH_RESEARCH_INDEX=research
# `local` provides complete public discovery without external infrastructure.
DEEPTECHLY_SEARCH_PROVIDER=local

# Health/config boundaries only until the durable-workflow and observability phases.
TRIGGER_BASE_URL=
TRIGGER_API_KEY=
TRIGGER_HEALTH_PATH=/api/v1/health
LANGFUSE_BASE_URL=
LANGFUSE_API_KEY=
LANGFUSE_HEALTH_PATH=/api/public/health
