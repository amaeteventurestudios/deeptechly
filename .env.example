OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ENABLE_WEB_SEARCH=true
NEXT_PUBLIC_SITE_URL=https://deeptechly.vercel.app

# Identity provider. Supabase preserves current production behavior.
# Appwrite remains fail-closed until an Appwrite project and cookie strategy are configured.
DEEPTECHLY_AUTH_PROVIDER=supabase
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=

# Research workflow. `local` preserves current behavior; `trigger` requires every value below.
DEEPTECHLY_WORKFLOW_PROVIDER=local
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Optional for a self-hosted Trigger.dev API; managed Trigger.dev uses its SDK default.
TRIGGER_API_URL=
DEEPTECHLY_INTERNAL_WEB_URL=
# Generate independently for each environment; minimum 24 characters.
DEEPTECHLY_WORKER_CALLBACK_SECRET=

# V2 PostgreSQL. No migration or import command runs automatically.
# Keep unset until an operator has provisioned an isolated target and reviewed docs/v2/07_DATA_MIGRATION_PLAN.md.
DATABASE_URL=
DEEPTECHLY_DATABASE_SCHEMA=deeptechly

# Supabase compatibility auth, profiles, admin, and persistent research storage.
# Run supabase/research-store.sql once, then set these on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
DEEPTECHLY_BOOTSTRAP_ADMIN_EMAIL=
DEEPTECHLY_BOOTSTRAP_ADMIN_TEMP_PASSWORD=
# Optional override; defaults to deeptechly_research_store.
SUPABASE_RESEARCH_STORE_TABLE=deeptechly_research_store
# Discover and preserve the deployed key during export; this is the historical default.
DEEPTECHLY_RESEARCH_STORE_KEY=deeptechly:research-store:v1

# Optional persistent research storage for Vercel.
# Supabase is preferred. Upstash Redis or Vercel KV remain supported as fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV names are also supported:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional V2 capability adapters. Unset means disabled; configuration never starts a service.
CRAWL4AI_BASE_URL=
CRAWL4AI_TOKEN=
CRAWL4AI_HEALTH_PATH=/health
CRAWL4AI_ACQUIRE_PATH=/crawl
CRAWL4AI_TIMEOUT_MS=30000

DIRECTUS_BASE_URL=
DIRECTUS_TOKEN=
DIRECTUS_TIMEOUT_MS=15000
# Keep `compatibility` until the V2 PostgreSQL import and Directus collection setup are reconciled.
DEEPTECHLY_NEWSROOM_PROVIDER=compatibility
# Browser-facing Data Studio URL; never include a token.
DIRECTUS_STUDIO_URL=

MEILISEARCH_BASE_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_TIMEOUT_MS=15000
MEILISEARCH_RESEARCH_INDEX=research
# `local` provides complete public discovery without external infrastructure.
DEEPTECHLY_SEARCH_PROVIDER=local

# Health/config boundaries only until the durable-workflow and observability phases.
TRIGGER_BASE_URL=
TRIGGER_API_KEY=
TRIGGER_HEALTH_PATH=/api/v1/health
LANGFUSE_BASE_URL=
LANGFUSE_API_KEY=
LANGFUSE_HEALTH_PATH=/api/public/health
